# Copy to `app/.env` and fill in values. Never commit `.env`.

# ── Mon Peya backend (auth, access, subscriptions) ───────────────────────────
MONPEYA_API_URL=http://10.0.2.2:8081

# ── PeyaPay API (non-secret URLs) ─────────────────────────────────────────────
PEYAPAY_API_URL=https://test1-pey-peya.djogana-pay.com
PEYAPAY_CRYPTO_URL=https://djoganapayci.com/api10/peya-2.0/ncg
# PEYAPAY_USE_PROD=true
TOKEN_ENDPOINT=/authclient/token

# ── PeyaPay secrets (marchand_dart parity — keep only in .env) ───────────────
# Use quotes when the value contains # (otherwise dotenv treats # as a comment).
ENCRYPT_KEY=
QR_ENCRYPT_KEY=
APP_TOKEN=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Optional PeyaPay-specific aliases (override APP_ADMIN_* if set)
# PEYAPAY_APP_USERNAME=
# PEYAPAY_APP_PASSWORD=

# ── Mr Immo (product API — separate from Mon Peya backend) ─────────────────
IMMO_API_URL=http://10.0.2.2:8082

# ── Billetterie ───────────────────────────────────────────────────────────────
# Shared host (used when transport/event URLs are unset)
# Physical device: use your PC LAN IP (same host as MONPEYA_API_URL), e.g. http://192.168.x.x:8090
# Android emulator: http://10.0.2.2:8090
BILLETTERIE_API_URL=http://10.0.2.2:8090
# Optional split backends:
# BILLETTERIE_TRANSPORT_API_URL=http://10.0.2.2:8090
# BILLETTERIE_EVENT_API_URL=http://10.0.2.2:8091

# ── Debug / testing (debug builds only — ignored in release) ─────────────────
# FORCE_GUEST_MODE=true    # pretend no account on device (onboarding / signup flow)
# SKIP_FORCED_AUTH=true    # skip login prompts when opening modules or payments
