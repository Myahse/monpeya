# Copy to `app/.env` and fill in values. Never commit `.env`.
#
# Local backends (Mon Peya / Immo / Billetterie) need your PC LAN IP when
# testing on a physical phone. Instead of editing by hand each time Wi-Fi
# changes, run:
#   powershell -ExecutionPolicy Bypass -File app/tool/sync_dev_lan_host.ps1
# That rewrites local hosts in .env to the current default-route IPv4.
#
# USB debugging alternative (no IP edits): keep http://127.0.0.1:PORT and run
#   adb reverse tcp:8081 tcp:8081
#   adb reverse tcp:8082 tcp:8082
#   adb reverse tcp:8090 tcp:8090
# Android emulator: 10.0.2.2 always points at the host machine.

# ── Backends locaux (dev direct — current default) ────────────────────────────
# Emulator uses 10.0.2.2 (= host localhost). Physical devices: your PC LAN IP.
MONPEYA_API_URL=http://10.0.2.2:8081
BILLETTERIE_API_URL=http://10.0.2.2:8090
IMMO_API_URL=http://10.0.2.2:8082

# Backend unifié (gateway on 8082) — only if that process is running:
# MONPEYA_API_URL=http://10.0.2.2:8082/api/platform
# BILLETTERIE_API_URL=http://10.0.2.2:8082/api/billetterie
# IMMO_API_URL=http://10.0.2.2:8082/api/immo

# Optional WebSocket for live listings/favorites (defaults to ws://{api-host}/ws/realtime)
# IMMO_WS_URL=ws://10.0.2.2:8082/ws/realtime
# Optional WebSocket for live ticket/event updates (defaults to ws://{api-host}/ws)
# BILLETTERIE_WS_URL=ws://10.0.2.2:8082/ws

# ── PeyaPay API (externe — wallet) ───────────────────────────────────────────
PEYAPAY_API_URL=https://test1-pey-peya.djogana-pay.com
PEYAPAY_CRYPTO_URL=https://djoganapayci.com/api10/peya-2.0/ncg
# PEYAPAY_USE_PROD=true
TOKEN_ENDPOINT=/authclient/token

# ── PeyaPay secrets (marchand_dart parity — keep only in .env) ───────────────
# Use quotes when the value contains # (otherwise dotenv treats # as a comment).
ENCRYPT_KEY=
QR_ENCRYPT_KEY=
APP_TOKEN=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Optional PeyaPay-specific aliases (override APP_ADMIN_* if set)
# PEYAPAY_APP_USERNAME=
# PEYAPAY_APP_PASSWORD=

# ── Leadway Assurance (externe) ───────────────────────────────────────────────
# LEADWAY_LIFE_API_URL=https://lv-test.djogana-pay.com:9290

# ── Billetterie — URLs séparées transport/event (optionnel) ───────────────────
# BILLETTERIE_TRANSPORT_API_URL=http://10.0.2.2:8082/api/billetterie
# BILLETTERIE_EVENT_API_URL=http://10.0.2.2:8082/api/billetterie

# ── Mapbox (transport map road routing) ───────────────────────────────────────
# Create a token at https://account.mapbox.com/access-tokens/
# Enable Directions API. Public `pk.` tokens are fine for mobile Directions.
MAPBOX_ACCESS_TOKEN=

# ── Debug / testing (debug builds only — ignored in release) ─────────────────
# FORCE_GUEST_MODE=true
# SKIP_FORCED_AUTH=true
