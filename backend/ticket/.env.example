# Copy to `.env` and fill in values. Never commit `.env` (gitignored).
# Quote values that contain # (Mon peya / Peya parity).

# ── Crypto (QR HMAC — Mon peya ENCRYPT_KEY / QR_ENCRYPT_KEY) ─────────────────
#ENCRYPT_KEY=
#QR_ENCRYPT_KEY=

# ── Local Docker Oracle ───────────────────────────────────────────────────────
DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DATASOURCE_USERNAME=ticketing
DATASOURCE_PASSWORD=ticketing
ORACLE_PASSWORD=oracle_admin

# ── Peya HTTP API (profile: peya) ─────────────────────────────────────────────
PEYA_API_BASE_URL=https://test1-pey-peya.djogana-pay.com
PEYA_CRYPTO_URL=https://djoganapayci.com/api10/peya-2.0/ncg
PEYA_TOKEN_ENDPOINT=/authclient/token
PEYA_CODE_PAYS_RESIDENCE=CI
PEYA_APP_ADMIN_USERNAME=
PEYA_APP_ADMIN_PASSWORD=
# Aliases (Mon peya)
# PEYAPAY_APP_USERNAME=
# PEYAPAY_APP_PASSWORD=

# ── Remote Peya Oracle (profile: peya-oracle, VPN only) ───────────────────────
PEYA_ORACLE_JDBC_URL=
PEYA_ORACLE_USERNAME=
PEYA_ORACLE_PASSWORD=

# ── App toggles ─────────────────────────────────────────────────────────────
SERVER_PORT=8090
DOCKER_COMPOSE_ENABLED=true
TICKET_PURCHASE_DEBIT_ENABLED=false
SPRING_JPA_SHOW_SQL=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true

# Production overrides (example)
# SPRING_JPA_SHOW_SQL=false
# SPRINGDOC_SWAGGER_UI_ENABLED=false
# SPRINGDOC_API_DOCS_ENABLED=false
# TICKET_PURCHASE_DEBIT_ENABLED=true
