# Copy to `.env` and fill in values. Never commit `.env` (gitignored).

# ── Local Docker Oracle (Monpeya auth DB) ─────────────────────────────────────
DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1523/XEPDB1
DATASOURCE_USERNAME=monpeya
DATASOURCE_PASSWORD=monpeya
ORACLE_PASSWORD=oracle_admin
ORACLE_HOST_PORT=1523

# ── App ───────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
DOCKER_COMPOSE_ENABLED=true
SPRING_JPA_SHOW_SQL=true

# ── Auth session TTLs (hours) ─────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_HOURS=12
AUTH_REFRESH_TOKEN_DAYS=30

# ── Monpeya subscription prices (access only — not ticket prices) ─────────────
SUBSCRIPTION_CURRENCY=XOF
SUBSCRIPTION_CLIENT_PLAN_CODE=CLIENT_ACCESS
SUBSCRIPTION_CLIENT_PLAN_NAME=Acces client
SUBSCRIPTION_CLIENT_PRICE=1000
SUBSCRIPTION_BUSINESS_PLAN_CODE=BUSINESS_ACCESS
SUBSCRIPTION_BUSINESS_PLAN_NAME=Acces business
SUBSCRIPTION_BUSINESS_PRICE=5000

# ── PeyaPay HTTP API (used by auth service to verify / parse clients) ─────────
PEYA_API_ENABLED=true
PEYA_API_BASE_URL=https://test1-pey-peya.djogana-pay.com
PEYA_CRYPTO_URL=https://djoganapayci.com/api10/peya-2.0/ncg
PEYA_TOKEN_ENDPOINT=/authclient/token
PEYA_CODE_PAYS_RESIDENCE=CI
PEYA_APP_ADMIN_USERNAME=
PEYA_APP_ADMIN_PASSWORD=
