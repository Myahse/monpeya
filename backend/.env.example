# Copy to `backend/.env` — unified Mon Peya server (port 8082)
# Quote values that contain #.

ORACLE_PASSWORD=oracle_admin

# Platform module (schema monpeya)
PLATFORM_DATASOURCE_USERNAME=monpeya
PLATFORM_DATASOURCE_PASSWORD=monpeya

# Billetterie module (schema ticketing)
BILLETTERIE_DATASOURCE_USERNAME=ticketing
BILLETTERIE_DATASOURCE_PASSWORD=ticketing

# Immo module (schema immo)
IMMO_DATASOURCE_USERNAME=immo
IMMO_DATASOURCE_PASSWORD=immo
IMMO_UPLOAD_DIR=uploads/immo

# Peya HTTP API
PEYA_API_ENABLED=true
PEYA_API_BASE_URL=https://test1-pey-peya.djogana-pay.com
PEYA_CRYPTO_URL=https://djoganapayci.com/api10/peya-2.0/ncg
PEYA_APP_ADMIN_USERNAME=
PEYA_APP_ADMIN_PASSWORD=

# Crypto (QR — parity mobile)
# ENCRYPT_KEY=
# QR_ENCRYPT_KEY=

# Ports
GATEWAY_PORT=8082
ORACLE_HOST_PORT=1521

# Toggles
TICKET_PURCHASE_DEBIT_ENABLED=false
SPRING_JPA_SHOW_SQL=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
